# 复制本文件为 .env.local 并填入真实值（.env.local 不会提交到 git）
# 申请地址：https://lbs.amap.com/  →  控制台 → 应用管理 → 创建「Web端(JS API)」Key
# 同时记录该 Key 对应的「安全密钥 securityJsCode」
VITE_AMAP_KEY=
VITE_AMAP_JSCODE=

# Deepseek API Key —— 申请地址：https://platform.deepseek.com/  → API Keys
# 用于平台端健康报告 AI 生成（模型 deepseek-chat）；不配置时由本地规则引擎兜底
VITE_DS_API_KEY=
